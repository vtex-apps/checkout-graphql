{
  "name": "checkout-graphql",
  "vendor": "vtex",
  "version": "0.69.0",
  "title": "Checkout GraphQL",
  "description": "Checkout GraphQL API",
  "builders": {
    "graphql": "1.x",
    "node": "6.x"
  },
  "dependencies": {
    "vtex.country-data-settings": "0.x",
    "vtex.graphql-server": "1.x",
    "vtex.messages": "1.x"
  },
  "credentialType": "absolute",
  "mustUpdateAt": "2019-11-05",
  "registries": [
    "smartcheckout"
  ],
  "policies": [
    {
      "name": "vtex.messages:translate-messages"
    },
    {
      "name": "outbound-access",
      "attrs": {
        "host": "portal.vtexcommercestable.com.br",
        "path": "/api/checkout/pub/*"
      }
    },
    {
      "name": "outbound-access",
      "attrs": {
        "host": "portal.vtexcommercebeta.com.br",
        "path": "/api/checkout/pub/*"
      }
    },
    {
      "name": "outbound-access",
      "attrs": {
        "host": "portal.vtexcommercestable.com.br",
        "path": "/api/catalog-dataplane/*"
      }
    },
    {
      "name": "outbound-access",
      "attrs": {
        "host": "portal.vtexcommercebeta.com.br",
        "path": "/api/catalog-dataplane/*"
      }
    },
    {
      "name": "vtex.graphql-server:resolve-graphql"
    }
  ],
  "settingsSchema": {
    "title": "Checkout GraphQL",
    "type": "object",
    "properties": {
      "useCatalogDataPlaneForItemDetails": {
        "title": "Resolve cart item details directly from the catalog",
        "description": "When enabled, product name, SKU name and specifications are fetched straight from the catalog dataplane instead of through vtex.search-graphql.",
        "type": "boolean",
        "default": false
      }
    }
  },
  "$schema": "https://raw.githubusercontent.com/vtex/node-vtex-api/master/gen/manifest.schema"
}
